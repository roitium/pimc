{
  "name": "pimc",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.23.4",
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter \"@pimc/*\" dev",
    "dev:lab-blog": "bun run --filter @pimc/lab-blog dev",
    "dev:naive-blog": "bun run --filter @pimc/naive-blog dev",
    "build": "bun run --sequential --filter \"@pimc/*\" build",
    "build:lab-blog": "bun run --filter @pimc/lab-blog build",
    "build:naive-blog": "bun run --filter @pimc/naive-blog build",
    "check": "bun run --sequential --filter \"@pimc/*\" check",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:smoke": "bun run --filter @pimc/naive-blog test:smoke",
    "lint:lab-blog": "oxlint apps/lab-blog",
    "lint:naive-blog": "oxlint apps/naive-blog",
    "lint:fix": "oxlint . --fix"
  },
  "overrides": {
    "@types/hast": "3.0.5"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@tailwindcss/oxide",
    "esbuild",
    "protobufjs",
    "sharp",
    "workerd"
  ],
  "devDependencies": {
    "oxlint": "^1.90.0",
    "oxfmt": "^0.75.0",
    "@astrojs/compiler-rs": "^0.5.2",
    "svelte": "^5.57.3"
  },
  "license": "MIT"
}
