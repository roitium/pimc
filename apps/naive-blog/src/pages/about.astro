---
import { getEntry, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageTitle from "@/components/PageTitle";
import SocialIcon from "@/components/svgs/social-icons";
import { withBase } from "@/utils/paths";
import site from "@/data/siteMetadata";
import "@/css/gallery.css";
const author = await getEntry("pages", "about");
if (
  !author ||
  !author.data.publish_to.includes("personal") ||
  author.data.draft
)
  throw new Error(
    "Missing published contents/personal-blog/pages/about/index.md or index.mdx",
  );
const { Content } = await render(author);
const { name, occupation, company, email, twitter, linkedin, github } =
  author.data;
---

<BaseLayout
  title={author.data.title}
  description={author.data.description || undefined}
>
  <div class="lg:mx-auto lg:max-w-(--breakpoint-lg)">
    <PageTitle title={author.data.title} subtitle={author.data.subtitle} />
    <div class="items-start space-y-2 xl:grid xl:grid-cols-3 xl:gap-x-8 xl:space-y-0">
      <div class="flex flex-col items-center space-x-2 pt-8">
        <img
          src={withBase("/static/images/logo.png")}
          alt="avatar"
          width={192}
          height={192}
          loading="lazy"
          decoding="async"
          class="h-48 w-48 rounded-full"
        />
        <h3 class="pt-4 pb-2 font-bold text-2xl leading-8 tracking-tight">
          {name || site.author}
        </h3>
        <div class="text-gray-500 dark:text-gray-400">{occupation}</div>
        <div class="text-gray-500 dark:text-gray-400">{company}</div>
        <div class="flex space-x-3 pt-6">
          <SocialIcon
            kind="mail"
            href={email ? `mailto:${email}` : undefined}
          />
          <SocialIcon kind="github" href={github} />
          <SocialIcon kind="linkedin" href={linkedin} />
          <SocialIcon kind="x" href={twitter} />
        </div>
      </div>
      <article
        class="prose prose-slate dark:prose-invert max-w-none pt-8 pb-8 xl:col-span-2"
        data-article-gallery
      >
        <Content />
      </article>
    </div>
  </div>
</BaseLayout>
