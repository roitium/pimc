---
import Layout from "./Layout.astro";
import config from "@/config";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  date?: Date;
  updated_at?: Date | null;
};

const { site } = config;

const { title, description, ogImage, canonicalURL, date, updated_at } =
  Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title ?? site.title,
  image: ogImage,
  ...(date && { datePublished: date.toISOString() }),
  ...(updated_at && { dateModified: updated_at.toISOString() }),
  author: [
    {
      "@type": "Person",
      name: site.author,
      ...(site.profile && { url: site.profile }),
    },
  ],
};
---

<Layout {title} {description} {ogImage} {canonicalURL}>
  <Fragment slot="head">
    <!-- Override og:type for article pages -->
    <meta property="og:type" content="article" />

    {date && (
      <meta property="article:published_time" content={date.toISOString()} />
    )}
    {updated_at && (
      <meta
        property="article:modified_time"
        content={updated_at.toISOString()}
      />
    )}

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <slot />
</Layout>
