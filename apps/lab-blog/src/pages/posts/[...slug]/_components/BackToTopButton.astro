---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowNarrowUp from "@/assets/icons/IconArrowNarrowUp.svg";
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);
---

<div
  id="btt-btn-container"
  data-scroll-visible="false"
  inert
  class:list={[
    "fixed inset-e-4 bottom-8 z-50",
    "md:sticky md:inset-e-auto md:float-end md:me-1",
    "transition duration-200 motion-reduce:transition-none",
  ]}
>
  <button
    data-button="back-to-top"
    class:list={[
      "group relative bg-background px-2 py-1",
      "size-14 rounded-full shadow-xl",
      "md:h-8 md:w-fit md:rounded-md md:shadow-none md:focus-visible:rounded-none",
      "md:bg-background/35 md:bg-clip-padding md:backdrop-blur-lg",
    ]}
  >
    <span
      id="progress-indicator"
      class="absolute inset-0 -z-10 block size-14 scale-110 rounded-full bg-transparent md:hidden md:h-8 md:rounded-md"
    ></span>
    <IconArrowLeft class="inline-block rotate-90 md:hidden" />
    <span class="sr-only text-sm group-hover:text-accent md:not-sr-only">
      <IconArrowNarrowUp class="inline-block size-4" />
      {t.post.backToTop}
    </span>
  </button>
</div>

<style>
  #btt-btn-container[data-scroll-visible="false"] {
    opacity: 0;
    transform: translateY(1rem);
    pointer-events: none;
  }
</style>

<script>
  import { observeScrollControls } from "@pimc/content/scroll-controls";

  function backToTop() {
    const container = document.querySelector<HTMLElement>("#btt-btn-container");
    const button = container?.querySelector<HTMLButtonElement>(
      "[data-button='back-to-top']",
    );
    const indicator = container?.querySelector<HTMLElement>(
      "#progress-indicator",
    );
    if (!container || !button || !indicator) return;

    const controller = new AbortController();
    button.addEventListener(
      "click",
      () => {
        window.scrollTo({
          top: 0,
          behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
            ? "instant"
            : "smooth",
        });
      },
      { signal: controller.signal },
    );

    const stopObserving = observeScrollControls((visible) => {
      container.dataset.scrollVisible = String(visible);
      container.inert = !visible;
      container.setAttribute("aria-hidden", String(!visible));
    });

    let frame = 0;
    const updateProgress = () => {
      frame = 0;
      const root = document.documentElement;
      const total = root.scrollHeight - root.clientHeight;
      const progress =
        total > 0
          ? Math.min(100, Math.max(0, (root.scrollTop / total) * 100))
          : 0;
      indicator.style.backgroundImage = `conic-gradient(var(--accent) ${progress}%, transparent ${progress}%)`;
    };
    document.addEventListener(
      "scroll",
      () => {
        if (!frame) frame = requestAnimationFrame(updateProgress);
      },
      { passive: true, signal: controller.signal },
    );
    updateProgress();

    document.addEventListener(
      "astro:before-swap",
      () => {
        controller.abort();
        stopObserving();
        cancelAnimationFrame(frame);
      },
      { once: true, signal: controller.signal },
    );
  }
  document.addEventListener("astro:page-load", backToTop);
</script>
