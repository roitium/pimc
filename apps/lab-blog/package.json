{
  "name": "@pimc/lab-blog",
  "type": "module",
  "version": "6.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro check && astro build && pagefind --site dist && cp -r dist/pagefind public/ && node scripts/cf-headers.mjs",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "bun run --cwd ../.. format:check",
    "format": "bun run --cwd ../.. format",
    "lint": "bun run --cwd ../.. lint:lab-blog",
    "deploy": "bun run build && wrangler deploy",
    "cf:preview": "wrangler dev",
    "check": "astro check",
    "lint:fix": "bun run --cwd ../.. lint:lab-blog --fix"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.1.2",
    "@chinese-fonts/lxgwwenkai": "3.0.0",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.4.4",
    "dayjs": "^1.11.21",
    "katex": "^0.19.1",
    "lodash.kebabcase": "^4.1.1",
    "rehype-callouts": "^2.2.0",
    "rehype-katex": "^7.0.1",
    "remark-collapse": "^0.1.2",
    "remark-math": "^6.0.0",
    "remark-toc": "^9.0.0",
    "satori": "^0.26.0",
    "sharp": "^0.35.2",
    "slugify": "^1.6.9",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@pagefind/default-ui": "^1.5.2",
    "@shikijs/transformers": "^4.5.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.2"
  },
  "private": true,
  "license": "MIT"
}
