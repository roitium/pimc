{
  "name": "@pimc/naive-blog",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun run --cwd ../.. sync:contents && bun run dev:site",
    "build": "bun run --cwd ../.. sync:contents && bun run build:site",
    "serve": "wrangler dev",
    "check": "astro sync && tsc --noEmit && bun run --cwd ../../packages/astro-check check:site --root ../../apps/naive-blog",
    "lint": "bun run --cwd ../.. lint:naive-blog",
    "lint:fix": "bun run --cwd ../.. lint:naive-blog --fix",
    "format": "bun run --cwd ../.. format",
    "format:check": "bun run --cwd ../.. format:check",
    "test:smoke": "node scripts/migration-smoke.mjs",
    "deploy": "bun run build && wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "build:site": "astro build && node scripts/build-search.mjs",
    "dev:site": "astro dev --port 4322"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.2",
    "@astrojs/svelte": "^9.1.2",
    "@chinese-fonts/lxgwwenkai": "^3.0.0",
    "@giscus/react": "^3.1.0",
    "@headlessui/react": "2.2.10",
    "@pimc/content": "workspace:*",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "astro": "^7.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "fumadocs-core": "^16.17.10",
    "github-slugger": "^2.0.0",
    "katex": "^0.19.1",
    "lightgallery": "^3.0.0",
    "lucide-react": "^1.68.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reading-time": "1.5.0",
    "rss": "^1.2.2",
    "sharp": "^0.35.5",
    "sonner": "^2.0.5",
    "svelte": "^5.57.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-radix-colors": "^2.1.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vaul": "^1.1.2",
    "@lightgallery/react": "^3.0.0",
    "satori": "^0.26.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "19.3.0",
    "@types/rss": "^0.0.32",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.157.0",
    "pagefind": "^1.5.2",
    "@pagefind/default-ui": "^1.5.2"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "type": "module",
  "license": "MIT"
}
