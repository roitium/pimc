---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import config from "@/config";
import { useTranslations } from "@/i18n";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  size?: "sm" | "lg";
  date: string | Date;
  timezone?: string;
  updated_at?: string | Date | null;
};

const {
  date,
  updated_at,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
} = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const isModified = updated_at && updated_at > date;

const datetime = dayjs(isModified ? updated_at : date).tz(
  postTimezone ?? config.site.timezone,
);

const dateFormat = locale.toLowerCase().startsWith("zh")
  ? "YYYY年M月D日"
  : "D MMM, YYYY";

const formattedDate = datetime.format(dateFormat);
---

<div
  class:list={["flex items-center gap-x-2 text-muted-foreground", className]}
>
  <IconCalendar
    class:list={[
      "inline-block size-6 min-w-5.5",
      { "scale-90": size === "sm" },
    ]}
  />
  {isModified && (
    <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}>
      {t.post.updatedAt}:
    </span>
  )}
  <time
    class:list={["text-sm", { "sm:text-base": size === "lg" }]}
    datetime={datetime.toISOString()}
  >
    {formattedDate}
  </time>
</div>
