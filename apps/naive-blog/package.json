{
  "name": "@pimc/naive-blog",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun run --cwd ../.. sync:contents && bun run dev:site",
    "build": "bun run --cwd ../.. sync:contents && bun run build:site",
    "serve": "wrangler dev",
    "check": "astro check",
    "lint": "bun run --cwd ../.. lint:naive-blog",
    "lint:fix": "bun run --cwd ../.. lint:naive-blog --fix",
    "format": "bun run --cwd ../.. format",
    "format:check": "bun run --cwd ../.. format:check",
    "test:smoke": "node scripts/migration-smoke.mjs",
    "deploy": "bun run build && wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "build:site": "astro build",
    "dev:site": "astro dev --port 4322"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.2",
    "@chinese-fonts/lxgwwenkai": "^3.0.0",
    "@giscus/react": "^3.1.0",
    "@headlessui/react": "2.2.9",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "astro": "^7.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "github-slugger": "^2.0.0",
    "katex": "^0.16.22",
    "kbar": "0.1.0-beta.48",
    "lightgallery": "^2.8.3",
    "lucide-react": "^0.562.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "reading-time": "1.5.0",
    "rss": "^1.2.2",
    "sharp": "^0.34.2",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-radix-colors": "^2.1.0",
    "vaul": "^1.1.2",
    "@pimc/content": "workspace:*",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "@astrojs/svelte": "^9.1.2",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.33",
    "@types/react": "^19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/rss": "^0.0.32",
    "@vercel/og": "^0.8.5",
    "typescript": "^5.8.3",
    "vite": "^8.3.4",
    "wrangler": "^4.156.1"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "type": "module",
  "license": "MIT"
}
