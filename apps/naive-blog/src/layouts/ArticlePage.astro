---
import { getEntry, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostLayout from "@/layouts/PostLayout";
import TOC from "@/components/TOC";
import type { Toc } from "@pimc/content/toc";
import ArticleControls from "@/components/ArticlePageButtonGroup";
import Comments from "@/components/Comments";
import PasswordForm from "@/components/ArticlePasswordForm";
import { allPosts, allAuthors, type Post } from "@/services/content/core";
import {
  allCoreContent,
  coreContent,
  sortPostsByDate,
} from "@/services/content/utils";
import site from "@/data/siteMetadata";
import "@/css/shiki.css";
import "@/css/gallery.css";
import "katex/dist/katex.css";
const { post, unlocked = false } = Astro.props as {
  post: Post;
  unlocked?: boolean;
};
const showBody = !post.private || unlocked;
const sorted = allCoreContent(sortPostsByDate(allPosts));
const index = sorted.findIndex((item) => item.slug === post.slug);
// Navigation props contain public metadata only, never source bodies or passwords.
const prev =
  index >= 0 && sorted[index + 1]
    ? { path: sorted[index + 1].path, title: sorted[index + 1].title }
    : undefined;
const next =
  index >= 0 && sorted[index - 1]
    ? { path: sorted[index - 1].path, title: sorted[index - 1].title }
    : undefined;
const authors = allAuthors.filter((author) => author.slug === "default");
const rendered = showBody
  ? await render((await getEntry("posts", post._id))!)
  : null;
const Content = rendered?.Content;
const toc: Toc | undefined = rendered?.remarkPluginFrontmatter.articleToc;
const og = `/og/${post.slug}.png`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  datePublished: post.date.toISOString(),
  dateModified: (post.updated_at || post.date).toISOString(),
  description: post.description,
  image: site.socialBanner,
  url: new URL(`blog/${post.slug}`, `${site.siteUrl}/`).href,
  author: authors.map((author) => ({ "@type": "Person", name: author.name })),
};
---

<BaseLayout
  title={post.title}
  description={post.description}
  image={og}
  canonical={post.canonicalUrl}
  article={{
    date: post.date,
    updated_at: post.updated_at,
    authors: authors.map((author) => author.name),
  }}
  noindex={post.private || post.draft}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
  />
  <PostLayout content={coreContent(post)} prev={prev} next={next}>
    <ArticleControls slot="controls" toc={toc} client:load />
    <Comments slot="comments" client:load />
    {toc && (
      <div slot="table-of-contents" class="sticky top-24 pb-8">
        <div>
          <TOC toc={toc} collapseInactive client:load />
        </div>
      </div>
    )}
    {post.private && !unlocked ? (
      post.password ? (
        <PasswordForm slug={post.slug} client:load />
      ) : (
        <p>该文章为私密且没有设置密码，不能给你看哦~</p>
      )
    ) : (
      Content && (
        <div
          data-article-body
          data-article-gallery
          data-pagefind-body={!post.private && !post.draft ? "" : undefined}
        >
          <Content />
        </div>
      )
    )}
  </PostLayout>
</BaseLayout>
